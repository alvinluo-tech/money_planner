# =============================================================================
# Money Planner — 极简环境变量配置
# 复制本文件为 .env 即可使用。
# =============================================================================

# ===== 1. 数据库存储（Supabase 持久化）=====
# 在 Supabase 创建项目后填入 Project Settings -> API 中的 URL 和 anon key
# 若不填写，应用将自动进入「本地纯内存演示模式」
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== 2. AI 大模型（以 DeepSeek 为例）=====
# 平台地址：https://platform.deepseek.com 获取 API Key
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
# 推荐使用官方最新主力模型 deepseek-flash（高性价比、支持多模态与结构化解析）或 deepseek-v4-pro
AI_MODEL=deepseek-flash

# ===== 3. 可选配置 =====
# 单用户密码保护（设置后访问需输入密码，适合个人部署）：
# APP_PASSWORD=

# 语音转文字 STT（DeepSeek 不提供音频转文字，如需云端 Whisper 推荐 Groq / 硅基流动 / OpenAI）：
# STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3
