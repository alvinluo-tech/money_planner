# ---------------------------------------------------------------------------
# Money Planner — 环境变量
# 复制本文件为 .env.local 后填写。缺失的变量会让对应功能自动降级（见 README）。
# ---------------------------------------------------------------------------

# ===== Supabase（不填则自动进入本地演示模式 / demo mode）=====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 注意：本项目不使用 service_role key（所有请求都在 RLS 之下），不要把它加进来。

# ===== 应用 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# demo | supabase  留空则按 Supabase 变量是否存在自动判断
APP_DATA_MODE=
# 单用户极简登录密码（设置后将取代魔术链接鉴权）
APP_PASSWORD=

# ===== 大模型（结构化解析 + 消费分析）=====
# 任何 OpenAI 兼容端点均可：OpenAI / DeepSeek / 通义千问 / Moonshot / 智谱 / Ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 部分国产模型不支持 response_format=json_object，设为 false 会改用「提示词约束 + 文本抽取」
AI_JSON_MODE=true
AI_TIMEOUT_MS=45000

# ===== 语音转文字（STT）=====
# 可复用上面同一家：OpenAI whisper-1 / Groq whisper-large-v3 / 硅基流动 SenseVoice 等
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_LANGUAGE=zh

# ===== 汇率 =====
# 免费无需 key：frankfurter(ECB) 与 open.er-api 会自动互为兜底
FX_PRIMARY_URL=https://api.frankfurter.app
FX_FALLBACK_URL=https://open.er-api.com/v6
FX_CACHE_TTL_HOURS=12
